package com.prototype.vulnwatch.service;

import com.prototype.vulnwatch.domain.Finding;
import com.prototype.vulnwatch.domain.FindingStatus;
import java.util.Optional;
import org.springframework.stereotype.Service;

// @Service - Temporarily disabled for compilation
public class VexCorrelationService {

    public VexApplicability correlateGhsaToVex(String cveId, String packageName, String version) {
        if (cveId == null || packageName == null) {
            return VexApplicability.UNKNOWN;
        }

        return VexApplicability.UNKNOWN;
    }

    public boolean suppressFindingIfVexNotAffected(Finding finding) {
        if (finding == null || finding.getVexStatus() == null) {
            return false;
        }

        String vexStatus = finding.getVexStatus().toUpperCase();
        if ("NOT_AFFECTED".equals(vexStatus)) {
            finding.setStatus(FindingStatus.SUPPRESSED);
            finding.setVexGhsaConfidence(1.0);
            return true;
        }

        if ("FIXED".equals(vexStatus)) {
            finding.setStatus(FindingStatus.RESOLVED);
            finding.setVexGhsaConfidence(0.9);
            return true;
        }

        return false;
    }

    public enum VexApplicability {
        AFFECTED,
        NOT_AFFECTED,
        FIXED,
        UNDER_INVESTIGATION,
        UNKNOWN
    }
}
