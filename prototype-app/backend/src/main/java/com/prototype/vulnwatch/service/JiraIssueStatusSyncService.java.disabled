package com.prototype.vulnwatch.service;

import com.prototype.vulnwatch.domain.Finding;
import com.prototype.vulnwatch.domain.FindingStatus;
import com.prototype.vulnwatch.domain.Tenant;
import com.prototype.vulnwatch.repo.FindingRepository;
import java.time.Instant;
import java.util.List;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.scheduling.annotation.Scheduled;
import org.springframework.stereotype.Service;
import org.springframework.transaction.support.TransactionTemplate;

/**
 * Syncs Jira ticket status back to VulnWatch Finding records.
 * Runs every 30 minutes per-tenant.
 * Multi-tenant isolation: uses tenant context for credential lookup and data access.
 * Security: validates tenant ownership before updating findings.
 */
// @Service - Temporarily disabled for compilation
public class JiraIssueStatusSyncService {

    private static final Logger log = LoggerFactory.getLogger(JiraIssueStatusSyncService.class);

    private final FindingRepository findingRepository;
    private final TenantService tenantService;
    private final TenantSchemaExecutionService tenantSchemaExecutionService;
    private final JiraConfigService jiraConfigService;
    private final JiraApiClient jiraApiClient;
    private final TransactionTemplate transactionTemplate;

    @Value("${app.jira.status-sync-enabled:true}")
    private boolean syncEnabled;

    public JiraIssueStatusSyncService(
            FindingRepository findingRepository,
            TenantService tenantService,
            TenantSchemaExecutionService tenantSchemaExecutionService,
            JiraConfigService jiraConfigService,
            JiraApiClient jiraApiClient,
            TransactionTemplate transactionTemplate
    ) {
        this.findingRepository = findingRepository;
        this.tenantService = tenantService;
        this.tenantSchemaExecutionService = tenantSchemaExecutionService;
        this.jiraConfigService = jiraConfigService;
        this.jiraApiClient = jiraApiClient;
        this.transactionTemplate = transactionTemplate;
    }

    @Scheduled(fixedDelayString = "${app.jira.status-sync-interval-ms:1800000}")
    public void syncJiraIssueStatus() {
        if (!syncEnabled) {
            log.debug("Jira status sync is disabled");
            return;
        }

        try {
            log.info("Starting Jira issue status sync job");
            int totalSynced = 0;
            int totalUpdated = 0;
            int totalClosed = 0;
            int totalErrors = 0;

            for (Tenant tenant : tenantService.listActiveTenants()) {
                try {
                    SyncResult result = syncStatusForTenant(tenant);
                    totalSynced += result.synced;
                    totalUpdated += result.updated;
                    totalClosed += result.closed;
                    totalErrors += result.errors;
                } catch (Exception e) {
                    log.error("Failed to sync Jira status for tenant {}: {}", tenant.getId(), e.getMessage(), e);
                    totalErrors++;
                }
            }

            log.info("Jira status sync complete: synced={}, updated={}, closed={}, errors={}",
                    totalSynced, totalUpdated, totalClosed, totalErrors);
        } catch (Exception e) {
            log.error("Jira status sync job failed", e);
        }
    }

    /**
     * Syncs Jira status for a single tenant.
     * Multi-tenant: executed within tenant context using TenantSchemaExecutionService.
     * Returns result counts for monitoring.
     */
    private SyncResult syncStatusForTenant(Tenant tenant) {
        return tenantSchemaExecutionService.run(tenant, () -> {
            log.debug("Syncing Jira status for tenant {}", tenant.getId());

            // Get Jira config for this tenant
            var jiraConfig = jiraConfigService.get(tenant);
            if (jiraConfig == null || !jiraConfig.enabled()) {
                log.debug("Jira not enabled for tenant {}", tenant.getId());
                return new SyncResult(0, 0, 0, 0);
            }

            // Get all findings with Jira tickets for this tenant
            List<Finding> findingsWithTickets = findingRepository.findByTenant_IdAndJiraTicketKeyIsNotNull(tenant.getId());
            if (findingsWithTickets.isEmpty()) {
                log.debug("No findings with Jira tickets for tenant {}", tenant.getId());
                return new SyncResult(0, 0, 0, 0);
            }

            int synced = 0;
            int updated = 0;
            int closed = 0;
            int errors = 0;

            for (Finding finding : findingsWithTickets) {
                try {
                    String ticketKey = finding.getJiraTicketKey();

                    // Query Jira API for current ticket status
                    String currentStatus = queryJiraTicketStatus(tenant, ticketKey);
                    if (currentStatus == null) {
                        log.warn("Could not fetch status for Jira ticket {} (Finding {})", ticketKey, finding.getId());
                        errors++;
                        continue;
                    }

                    synced++;

                    // Update finding if status changed
                    String previousStatus = finding.getJiraTicketStatus();
                    if (!currentStatus.equals(previousStatus)) {
                        finding.setJiraTicketStatus(currentStatus);

                        // Auto-close finding if ticket is resolved/done
                        if (isResolvedStatus(currentStatus) && finding.getStatus() != FindingStatus.CLOSED) {
                            log.info("Auto-closing Finding {} due to Jira ticket {} status change to {}",
                                    finding.getId(), ticketKey, currentStatus);
                            finding.setStatus(FindingStatus.CLOSED);
                            finding.setClosedAt(Instant.now());
                            finding.setClosedBy("jira-sync");
                            closed++;
                        }

                        finding.touch();
                        findingRepository.save(finding);
                        updated++;

                        log.debug("Updated Jira status for Finding {}: {} -> {}",
                                finding.getId(), previousStatus, currentStatus);
                    }

                } catch (Exception e) {
                    log.error("Error syncing Jira status for Finding {}: {}", finding.getId(), e.getMessage());
                    errors++;
                }
            }

            return new SyncResult(synced, updated, closed, errors);
        });
    }

    /**
     * Queries Jira API for the current status of a ticket.
     * Uses tenant context for credential resolution.
     * Security: tenantSchemaExecutionService ensures tenant isolation.
     */
    private String queryJiraTicketStatus(Tenant tenant, String ticketKey) {
        try {
            // Resolve runtime Jira config (with decrypted credentials)
            var runtimeConfig = jiraConfigService.resolveRuntimeConfig(tenant);
            if (runtimeConfig == null) {
                log.warn("Could not resolve Jira runtime config for tenant {}", tenant.getId());
                return null;
            }

            // Query Jira API for ticket status
            String status = jiraApiClient.getIssueStatus(runtimeConfig, ticketKey);

            if (status == null) {
                log.warn("Jira API did not return status for ticket {}", ticketKey);
                return null;
            }

            log.debug("Fetched Jira ticket {} status: {}", ticketKey, status);
            return status;

        } catch (Exception e) {
            log.error("Exception querying Jira status for ticket {}: {}", ticketKey, e.getMessage());
            return null;
        }
    }

    /**
     * Determines if a Jira status represents a resolved/closed state.
     * Supports common Jira status workflows: RESOLVED, DONE, CLOSED, ARCHIVED.
     */
    private boolean isResolvedStatus(String status) {
        if (status == null) return false;
        String normalized = status.trim().toUpperCase();
        return normalized.equals("RESOLVED") ||
               normalized.equals("DONE") ||
               normalized.equals("CLOSED") ||
               normalized.equals("ARCHIVED");
    }

    private static class SyncResult {
        final int synced;
        final int updated;
        final int closed;
        final int errors;

        SyncResult(int synced, int updated, int closed, int errors) {
            this.synced = synced;
            this.updated = updated;
            this.closed = closed;
            this.errors = errors;
        }
    }
}
