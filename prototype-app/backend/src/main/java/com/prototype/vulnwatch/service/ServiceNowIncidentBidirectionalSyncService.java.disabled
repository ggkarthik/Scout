package com.prototype.vulnwatch.service;

import com.prototype.vulnwatch.client.ServiceNowApiClient;
import com.prototype.vulnwatch.domain.Finding;
import com.prototype.vulnwatch.domain.FindingStatus;
import com.prototype.vulnwatch.domain.Tenant;
import com.prototype.vulnwatch.repo.FindingRepository;
import java.time.Instant;
import java.util.List;
import java.util.Map;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.scheduling.annotation.Scheduled;
import org.springframework.stereotype.Service;
import org.springframework.transaction.support.TransactionTemplate;

/**
 * Bidirectional sync for ServiceNow incidents.
 * Pulls status changes from ServiceNow AND pushes updates back to ServiceNow.
 * Runs every 30 minutes per-tenant.
 * Multi-tenant isolation: uses tenant context for credential lookup and data access.
 * Security: validates tenant ownership before updating findings.
 */
// DISABLED - Compilation errors in method bodies
class ServiceNowIncidentBidirectionalSyncService_Disabled {

    private static final Logger log = LoggerFactory.getLogger(ServiceNowIncidentBidirectionalSyncService.class);

    private final FindingRepository findingRepository;
    private final TenantService tenantService;
    private final TenantSchemaExecutionService tenantSchemaExecutionService;
    private final ServiceNowConfigService serviceNowConfigService;
    private final ServiceNowApiClient serviceNowApiClient;
    private final TransactionTemplate transactionTemplate;

    @Value("${app.servicenow.bidirectional-sync-enabled:true}")
    private boolean bidirectionalSyncEnabled;

    public ServiceNowIncidentBidirectionalSyncService(
            FindingRepository findingRepository,
            TenantService tenantService,
            TenantSchemaExecutionService tenantSchemaExecutionService,
            ServiceNowConfigService serviceNowConfigService,
            ServiceNowApiClient serviceNowApiClient,
            TransactionTemplate transactionTemplate
    ) {
        this.findingRepository = findingRepository;
        this.tenantService = tenantService;
        this.tenantSchemaExecutionService = tenantSchemaExecutionService;
        this.serviceNowConfigService = serviceNowConfigService;
        this.serviceNowApiClient = serviceNowApiClient;
        this.transactionTemplate = transactionTemplate;
    }

    @Scheduled(fixedDelayString = "${app.servicenow.bidirectional-sync-interval-ms:1800000}")
    public void syncServiceNowIncidents() {
        if (!bidirectionalSyncEnabled) {
            log.debug("ServiceNow bidirectional sync is disabled");
            return;
        }

        try {
            log.info("Starting ServiceNow bidirectional sync job");
            int totalSynced = 0;
            int totalUpdated = 0;
            int totalPushed = 0;
            int totalClosed = 0;
            int totalErrors = 0;

            for (Tenant tenant : tenantService.listActiveTenants()) {
                try {
                    SyncResult result = syncIncidentsForTenant(tenant);
                    totalSynced += result.synced;
                    totalUpdated += result.updated;
                    totalPushed += result.pushed;
                    totalClosed += result.closed;
                    totalErrors += result.errors;
                } catch (Exception e) {
                    log.error("Failed to sync ServiceNow incidents for tenant {}: {}", tenant.getId(), e.getMessage(), e);
                    totalErrors++;
                }
            }

            log.info("ServiceNow sync complete: synced={}, updated={}, pushed={}, closed={}, errors={}",
                    totalSynced, totalUpdated, totalPushed, totalClosed, totalErrors);
        } catch (Exception e) {
            log.error("ServiceNow bidirectional sync job failed", e);
        }
    }

    /**
     * Syncs ServiceNow incidents for a single tenant (bidirectional).
     * Multi-tenant: executed within tenant context.
     * Returns result counts for monitoring.
     */
    private SyncResult syncIncidentsForTenant(Tenant tenant) {
        return tenantSchemaExecutionService.run(tenant, () -> {
            log.debug("Syncing ServiceNow incidents (bidirectional) for tenant {}", tenant.getId());

            // Get ServiceNow config for this tenant
            var serviceNowConfig = serviceNowConfigService.get(tenant);
            if (serviceNowConfig == null || !serviceNowConfig.enabled()) {
                log.debug("ServiceNow not enabled for tenant {}", tenant.getId());
                return new SyncResult(0, 0, 0, 0, 0);
            }

            // Get all findings with ServiceNow incidents for this tenant
            List<Finding> findingsWithIncidents = findingRepository
                    .findByTenant_IdAndIncidentIdIsNotNull(tenant.getId());
            if (findingsWithIncidents.isEmpty()) {
                log.debug("No findings with ServiceNow incidents for tenant {}", tenant.getId());
                return new SyncResult(0, 0, 0, 0, 0);
            }

            int synced = 0;
            int updated = 0;
            int pushed = 0;
            int closed = 0;
            int errors = 0;

            // PULL: Sync status from ServiceNow → Findings
            for (Finding finding : findingsWithIncidents) {
                try {
                    String incidentId = finding.getIncidentId();

                    // Query ServiceNow API for current incident status
                    Map<String, Object> incidentDetails = queryServiceNowIncidentStatus(tenant, incidentId);
                    if (incidentDetails == null) {
                        log.warn("Could not fetch status for ServiceNow incident {} (Finding {})",
                                incidentId, finding.getId());
                        errors++;
                        continue;
                    }

                    synced++;

                    // Update finding if status changed (PULL)
                    String currentStatus = incidentDetails.getOrDefault("state", "").toString();
                    String previousStatus = finding.getIncidentStatus();
                    if (!currentStatus.equals(previousStatus)) {
                        finding.setIncidentStatus(currentStatus);

                        // Auto-close finding if incident is resolved/closed
                        if (isResolvedStatus(currentStatus) && finding.getStatus() != FindingStatus.CLOSED) {
                            log.info("Auto-closing Finding {} due to ServiceNow incident {} status change to {}",
                                    finding.getId(), incidentId, currentStatus);
                            finding.setStatus(FindingStatus.CLOSED);
                            finding.setClosedAt(Instant.now());
                            finding.setClosedBy("servicenow-sync");
                            closed++;
                        }

                        finding.touch();
                        findingRepository.save(finding);
                        updated++;

                        log.debug("Updated ServiceNow status for Finding {}: {} -> {}",
                                finding.getId(), previousStatus, currentStatus);
                    }

                    // PUSH: Sync updates from Findings → ServiceNow (if finding status changed)
                    if (shouldPushUpdateToServiceNow(finding)) {
                        try {
                            pushFindingUpdateToServiceNow(tenant, finding, incidentId);
                            pushed++;
                        } catch (Exception e) {
                            log.warn("Failed to push update to ServiceNow for incident {}: {}",
                                    incidentId, e.getMessage());
                            // Don't fail the entire sync, just log and continue
                        }
                    }

                } catch (Exception e) {
                    log.error("Error syncing ServiceNow incident for Finding {}: {}", finding.getId(), e.getMessage());
                    errors++;
                }
            }

            return new SyncResult(synced, updated, pushed, closed, errors);
        });
    }

    /**
     * Queries ServiceNow API for the current status of an incident.
     * Uses tenant context for credential resolution.
     * Security: tenantSchemaExecutionService ensures tenant isolation.
     */
    private Map<String, Object> queryServiceNowIncidentStatus(Tenant tenant, String incidentId) {
        try {
            // Resolve runtime ServiceNow config (with decrypted credentials)
            var runtimeConfig = serviceNowConfigService.resolveRuntimeConfig(tenant);
            if (runtimeConfig == null) {
                log.warn("Could not resolve ServiceNow runtime config for tenant {}", tenant.getId());
                return null;
            }

            // Query ServiceNow API for incident details
            Map<String, Object> incidentDetails = serviceNowApiClient.getIncidentStatus(
                    runtimeConfig.baseUrl(),
                    runtimeConfig.username(),
                    runtimeConfig.credential(),
                    incidentId
            );

            if (incidentDetails == null) {
                log.warn("ServiceNow API did not return incident details for {}", incidentId);
                return null;
            }

            log.debug("Fetched ServiceNow incident {} status: {}", incidentId, incidentDetails.get("state"));
            return incidentDetails;

        } catch (Exception e) {
            log.error("Exception querying ServiceNow status for incident {}: {}", incidentId, e.getMessage());
            return null;
        }
    }

    /**
     * Determines if a Finding update should be pushed back to ServiceNow.
     * Only push updates if the finding has been modified recently.
     */
    private boolean shouldPushUpdateToServiceNow(Finding finding) {
        // Don't push if finding hasn't been modified in last sync window
        if (finding.getUpdatedAt() == null) {
            return false;
        }

        long syncInterval = 30 * 60 * 1000; // 30 minutes
        long timeSinceUpdate = System.currentTimeMillis() - finding.getUpdatedAt().toEpochMilli();

        return timeSinceUpdate < syncInterval;
    }

    /**
     * Pushes Finding updates back to ServiceNow incident.
     * Updates: comments, priority, assignment, tags.
     */
    private void pushFindingUpdateToServiceNow(Tenant tenant, Finding finding, String incidentId) {
        try {
            var runtimeConfig = serviceNowConfigService.resolveRuntimeConfig(tenant);
            if (runtimeConfig == null) {
                log.warn("Could not resolve ServiceNow config for tenant {} to push update", tenant.getId());
                return;
            }

            // Build update payload
            Map<String, Object> updatePayload = Map.of(
                    "short_description", "Finding: " + finding.getDisplayId(),
                    "priority", mapFindingToServiceNowPriority(finding),
                    "work_notes", "Updated via VulnWatch - Risk Score: " + finding.getRiskScore()
            );

            // Push update to ServiceNow
            serviceNowApiClient.updateIncident(
                    runtimeConfig.baseUrl(),
                    runtimeConfig.username(),
                    runtimeConfig.credential(),
                    incidentId,
                    updatePayload
            );

            log.debug("Pushed update to ServiceNow incident {} for Finding {}", incidentId, finding.getId());

        } catch (Exception e) {
            log.error("Error pushing update to ServiceNow: {}", e.getMessage());
            throw new RuntimeException("Failed to push update to ServiceNow", e);
        }
    }

    /**
     * Maps VulnWatch finding risk score to ServiceNow priority.
     */
    private Integer mapFindingToServiceNowPriority(Finding finding) {
        double riskScore = finding.getRiskScore();
        if (riskScore >= 9.0) return 1; // Critical
        if (riskScore >= 7.0) return 2; // High
        if (riskScore >= 5.0) return 3; // Medium
        return 4; // Low
    }

    /**
     * Determines if a ServiceNow status represents a resolved/closed state.
     * Supports common ServiceNow status codes.
     */
    private boolean isResolvedStatus(String status) {
        if (status == null) return false;
        String normalized = status.trim().toLowerCase();
        return normalized.equals("resolved") ||
               normalized.equals("closed") ||
               normalized.equals("completed") ||
               normalized.equals("7"); // ServiceNow resolved state code
    }

    private static class SyncResult {
        final int synced;
        final int updated;
        final int pushed;
        final int closed;
        final int errors;

        SyncResult(int synced, int updated, int pushed, int closed, int errors) {
            this.synced = synced;
            this.updated = updated;
            this.pushed = pushed;
            this.closed = closed;
            this.errors = errors;
        }
    }
}
