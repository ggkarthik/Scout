package com.prototype.vulnwatch.config;

import com.prototype.vulnwatch.domain.SccmCmdbConfig;
import com.prototype.vulnwatch.repo.SccmCmdbConfigRepository;
import com.prototype.vulnwatch.service.TenantService;
import com.prototype.vulnwatch.service.patch.PatchIngestionTask;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.scheduling.annotation.Scheduled;
import org.springframework.stereotype.Component;

import java.util.HashMap;
import java.util.Map;

@Component
@Slf4j
@RequiredArgsConstructor
public class PatchSyncSchedulingConfig {

    private final SccmCmdbConfigRepository sccmConfigRepository;
    private final PatchIngestionTask patchIngestionTask;
    private final TenantService tenantService;

    /**
     * Scheduled job to ingest patches from SCCM every 6 hours.
     * Runs for all tenants that have SCCM patch sync enabled.
     */
    @Scheduled(fixedDelayString = "${app.patch-sync.sccm-interval:21600000}", initialDelayString = "${app.patch-sync.sccm-initial-delay:60000}")
    public void scheduleSccmPatchSync() {
        try {
            log.debug("Starting scheduled SCCM patch sync");

            tenantService.listTenants().forEach(tenant -> {
                try {
                    // Check if SCCM patch sync is enabled for this tenant
                    var config = sccmConfigRepository.findByTenant(tenant);
                    if (config.isPresent() && config.get().isPatchQueryEnabled()) {
                        log.info("Triggering SCCM patch sync for tenant: {}", tenant.getId());

                        Map<String, String> filters = new HashMap<>();
                        filters.put("site_code", config.get().getSiteCode());
                        filters.put("limit", "1000");

                        patchIngestionTask.ingestPatchesAsync(tenant.getId(), "SCCM", filters);
                    }
                } catch (Exception e) {
                    log.error("Error triggering SCCM patch sync for tenant {}: {}",
                        tenant.getId(), e.getMessage(), e);
                }
            });
        } catch (Exception e) {
            log.error("Scheduled SCCM patch sync failed: {}", e.getMessage(), e);
        }
    }

    /**
     * Additional schedulers for BigFix and Tanium can be added here in Phase 2.
     */
}
