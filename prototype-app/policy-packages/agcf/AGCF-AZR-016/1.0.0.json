{
  "policyId": "AGCF-AZR-016",
  "version": "1.0.0",
  "name": "Foundry model version or upgrade option violates the patch/lifecycle baseline",
  "description": "Detects when foundry model version or upgrade option violates the patch/lifecycle baseline using only declared evidence.",
  "securityIntent": "Prevent the risk condition described by AGCF-AZR-016.",
  "remediationIntent": "Correct the provider configuration or relationship and reassess with complete, fresh evidence.",
  "owner": "AI Grid Security",
  "lifecycle": "VALIDATED",
  "releaseStatus": "PAUSED",
  "controlObjectiveId": "AGCF-OBJ-AZR-016",
  "provider": "AZURE",
  "evaluationMode": "ARTIFACT_FACTS",
  "evaluationDefinition": {
    "mode": "ARTIFACT_FACTS",
    "artifactFacts": {
      "predicate": {
        "any": [
          {
            "not": {
              "fact": "model.version_configured",
              "in": {
                "parameter": "approvedModelVersions"
              }
            }
          },
          {
            "not": {
              "fact": "model.version_upgrade_option_configured",
              "in": {
                "parameter": "approvedUpgradeOptions"
              }
            }
          }
        ]
      }
    }
  },
  "baseEvidenceTiers": [
    "E1"
  ],
  "conditionalCapabilities": [],
  "defaultSelection": "DISABLED",
  "releaseFamily": "AGCF_PHASE_1",
  "wave": "PHASE_1",
  "workflowClass": "POSTURE_FINDING",
  "artifactTypes": [],
  "nativeKinds": [
    "AZURE_FOUNDRY_DEPLOYMENTS"
  ],
  "requiredCapabilities": [
    "AI_ACCOUNTS"
  ],
  "requiredRelationships": [],
  "requiredResourceFamilies": [],
  "requiredFacts": [
    {
      "factKey": "model.version_configured",
      "valueType": "STRING",
      "evidenceClasses": [
        "CONFIGURATION"
      ],
      "maxAgeSeconds": 86400
    },
    {
      "factKey": "model.version_upgrade_option_configured",
      "valueType": "STRING",
      "evidenceClasses": [
        "CONFIGURATION"
      ],
      "maxAgeSeconds": 86400
    }
  ],
  "frameworkMappings": [
