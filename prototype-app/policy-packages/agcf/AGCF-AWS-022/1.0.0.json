  "artifactTypes": [],
  "nativeKinds": [
    "AWS_BEDROCK_DATA_SOURCE"
  ],
  "requiredCapabilities": [
    "BEDROCK_AGENTS"
  ],
  "requiredRelationships": [],
  "requiredResourceFamilies": [],
