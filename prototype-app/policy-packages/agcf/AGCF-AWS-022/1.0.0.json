{
  "policyId": "AGCF-AWS-022",
  "version": "1.0.0",
  "name": "Bedrock data deletion policy violates the tenant retention baseline",
  "description": "Detects when bedrock data deletion policy violates the tenant retention baseline using only declared evidence.",
  "securityIntent": "Prevent the risk condition described by AGCF-AWS-022.",
  "remediationIntent": "Correct the provider configuration or relationship and reassess with complete, fresh evidence.",
  "owner": "AI Grid Security",
  "lifecycle": "PUBLISHED",
  "releaseStatus": "GENERAL_AVAILABILITY",
  "controlObjectiveId": "AGCF-OBJ-AWS-022",
  "provider": "AWS",
  "evaluationMode": "ARTIFACT_FACTS",
  "evaluationDefinition": {
    "mode": "ARTIFACT_FACTS",
    "artifactFacts": {
      "predicate": {
        "not": {
          "fact": "data.deletion_policy_configured",
          "in": {
            "parameter": "approvedDeletionPolicies"
          }
        }
      }
    }
  },
  "baseEvidenceTiers": [
    "E1"
  ],
  "conditionalCapabilities": [],
