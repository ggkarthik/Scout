{
  "policyId": "AGCF-AWS-034",
  "version": "1.0.0",
  "name": "MCP target subtype or server hostname is outside the tenant allowlist",
  "description": "Detects when mCP target subtype or server hostname is outside the tenant allowlist using only declared evidence.",
  "securityIntent": "Prevent the risk condition described by AGCF-AWS-034.",
  "remediationIntent": "Correct the provider configuration or relationship and reassess with complete, fresh evidence.",
  "owner": "AI Grid Security",
  "lifecycle": "PUBLISHED",
  "releaseStatus": "GENERAL_AVAILABILITY",
  "controlObjectiveId": "AGCF-OBJ-AWS-034",
  "provider": "AWS",
  "evaluationMode": "ARTIFACT_FACTS",
  "evaluationDefinition": {
    "mode": "ARTIFACT_FACTS",
    "artifactFacts": {
      "predicate": {
        "any": [
          {
            "not": {
              "fact": "mcp.target_subtype_configured",
              "in": {
                "parameter": "approvedMcpTargetSubtypes"
              }
            }
          },
          {
            "not": {
              "fact": "mcp.server_hostname_configured",
              "in": {
                "parameter": "approvedMcpServerHosts"
              }
            }
          }
        ]
      }
    }
  },
  "baseEvidenceTiers": [
    "E1",
    "E2"
  ],
  "conditionalCapabilities": [],
  "defaultSelection": "DISABLED",
  "releaseFamily": "AGCF_PHASE_1",
  "wave": "PHASE_1",
  "workflowClass": "POSTURE_FINDING",
  "artifactTypes": [],
  "nativeKinds": [
    "AWS_AGENTCORE_GATEWAY_TARGET",
    "AWS_AGENTCORE_MCP_SERVER"
  ],
  "requiredCapabilities": [
    "AGENTCORE_GATEWAYS_TARGETS"
  ],
  "requiredRelationships": [],
  "requiredResourceFamilies": [],
  "requiredFacts": [
    {
      "factKey": "mcp.target_subtype_configured",
      "valueType": "STRING",
      "evidenceClasses": [
        "CONFIGURATION"
      ],
      "maxAgeSeconds": 86400
    },
    {
      "factKey": "mcp.server_hostname_configured",
      "valueType": "STRING",
      "evidenceClasses": [
        "CONFIGURATION"
      ],
      "maxAgeSeconds": 86400
    }
  ],
  "frameworkMappings": [
