        "NOT_APPLICABLE"
      ]
    },
    {
      "key": "approvedMcpServerHosts",
      "type": "STRING_LIST",
      "defaultValue": [
        "NOT_APPLICABLE"
      ]
    }
  ],
  "certificationParameterProfile": {
    "immutable": true,
    "pass": {
