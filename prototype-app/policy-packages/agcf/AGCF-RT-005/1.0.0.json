{
  "policyId": "AGCF-RT-005",
  "version": "1.0.0",
  "name": "Consequential action succeeded without required approval",
  "description": "Fails when a consequential action was required to be approved and nevertheless completed successfully.",
  "securityIntent": "Ensure consequential agent actions cannot complete while their approval is still outstanding.",
  "remediationIntent": "Enforce the approval gate at the action's enforcement point and review the completed action.",
  "owner": "AI Grid Security",
  "lifecycle": "VALIDATED",
  "releaseStatus": "PAUSED",
  "controlObjectiveId": "AGCF-OBJ-RT-005",
  "provider": "MULTI_CLOUD",
  "evaluationMode": "RUNTIME_SEQUENCE",
  "evaluationDefinition": {
    "mode": "RUNTIME_SEQUENCE",
    "runtimeSequence": {
      "steps": [
        {
          "conditions": [
            {
              "field": "event.approval_state",
              "operator": "IN",
              "value": ["REQUIRED", "BYPASSED"]
            },
            {
              "field": "event.action_outcome",
              "operator": "EQ",
              "value": "SUCCEEDED"
            },
            {
              "field": "event.action_category",
              "operator": "IN",
              "value": ["WRITE", "DELETE", "SEND", "EXECUTE", "ADMIN", "PAYMENT", "PUBLISH"]
            }
          ]
        }
      ],
      "maximumDurationSeconds": 3600,
      "allowedLatenessSeconds": 300,
      "deduplicationKey": "execution.agent_artifact_id",
      "maximumEventsExamined": 1000,
      "explanationFields": [
        "event.action_category",
        "event.target_class",
        "event.enforcement_point"
      ]
    }
  },
  "baseEvidenceTiers": [
    "E1"
  ],
  "conditionalCapabilities": [],
  "defaultSelection": "PREVIEW",
  "releaseFamily": "AGCF_PHASE_2",
  "wave": "WAVE_2B",
  "workflowClass": "RUNTIME_FINDING",
  "evaluationSubject": "EXECUTION",
  "artifactTypes": [],
  "nativeKinds": [],
  "requiredCapabilities": [
    "RUNTIME_EVENT_DECISIONS",
    "RUNTIME_ACTION_OUTCOMES"
  ],
  "requiredRelationships": [],
  "requiredResourceFamilies": [],
  "requiredFacts": [],
  "reasonCode": "AGCF_RT_005_UNAPPROVED_CONSEQUENTIAL_ACTION",
  "frameworkMappings": [
    {
      "framework": "OWASP_AGENTIC_TOP_10",
      "frameworkVersion": "2026",
      "controlId": "ASI05",
      "mappingType": "DIRECT",
      "rationale": "Completing a consequential action without approval is unchecked autonomy."
    },
    {
      "framework": "OWASP_GENAI_LLM_TOP_10",
      "frameworkVersion": "2026",
      "controlId": "LLM06",
      "mappingType": "PARTIAL",
      "rationale": "Excessive agency is realised when approval gates do not hold."
    },
    {
      "framework": "CSA_AICM",
      "frameworkVersion": "1.1",
      "controlId": "GRC-05",
      "mappingType": "PARTIAL",
      "rationale": "Approval enforcement is a governance control."
    }
  ],
  "parameterDefinitions": [],
  "certificationParameterProfile": null,
  "packageSourceRef": "policy-packages/agcf/AGCF-RT-005/1.0.0.json"
}
