{
  "policyId": "AGCF-AZR-031",
  "version": "1.0.0",
  "name": "High-privilege Azure role assignment lacks the required condition or approved principal type",
  "description": "Detects when high-privilege Azure role assignment lacks the required condition or approved principal type using only declared evidence.",
  "securityIntent": "Prevent the risk condition described by AGCF-AZR-031.",
  "remediationIntent": "Correct the provider configuration or relationship and reassess with complete, fresh evidence.",
  "owner": "AI Grid Security",
  "lifecycle": "PUBLISHED",
  "releaseStatus": "GENERAL_AVAILABILITY",
  "controlObjectiveId": "AGCF-OBJ-AZR-031",
  "provider": "AZURE",
  "evaluationMode": "ARTIFACT_FACTS",
  "evaluationDefinition": {
    "mode": "ARTIFACT_FACTS",
    "artifactFacts": {
      "predicate": {
        "any": [
          {
            "fact": "identity.assignment_condition_version_configured",
            "empty": true
          },
          {
            "not": {
              "fact": "identity.principal_type_configured",
              "in": {
                "parameter": "approvedPrincipalTypes"
              }
            }
          }
        ]
      }
    }
  },
  "baseEvidenceTiers": [
    "E1"
  ],
  "conditionalCapabilities": [],
  "defaultSelection": "DISABLED",
  "releaseFamily": "AGCF_PHASE_1",
  "wave": "PHASE_1",
  "workflowClass": "POSTURE_FINDING",
  "artifactTypes": [],
  "nativeKinds": [
    "AZURE_RBAC_GLOBAL"
  ],
  "requiredCapabilities": [
    "RBAC_ASSIGNMENTS"
  ],
  "requiredRelationships": [],
  "requiredResourceFamilies": [],
  "requiredFacts": [
    {
      "factKey": "identity.assignment_condition_version_configured",
      "valueType": "STRING",
      "evidenceClasses": [
        "CONFIGURATION"
      ],
      "maxAgeSeconds": 86400
    },
    {
      "factKey": "identity.principal_type_configured",
      "valueType": "STRING",
      "evidenceClasses": [
        "CONFIGURATION"
      ],
      "maxAgeSeconds": 86400
    }
  ],
  "frameworkMappings": [
    {
      "framework": "OWASP_GENAI_LLM_TOP_10",
      "frameworkVersion": "2026",
      "controlId": "LLM03",
      "mappingType": "DIRECT",
      "rationale": "This control is independently mapped to the policy's stated security intent."
    },
    {
      "framework": "CSA_AICM",
      "frameworkVersion": "1.1",
      "controlId": "IAM-05",
      "mappingType": "DIRECT",
      "rationale": "This control is independently mapped to the policy's stated security intent."
    },
    {
      "framework": "CSA_AICM",
      "frameworkVersion": "1.1",
      "controlId": "IAM-10",
      "mappingType": "PARTIAL",
      "rationale": "This control is independently mapped to the policy's stated security intent."
    },
    {
      "framework": "CSA_AICM",
      "frameworkVersion": "1.1",
      "controlId": "IAM-15",
      "mappingType": "DIRECT",
      "rationale": "This control is independently mapped to the policy's stated security intent."
    }
  ],
  "parameterDefinitions": [
    {
      "key": "approvedPrincipalTypes",
      "type": "STRING_LIST",
      "defaultValue": [
        "ServicePrincipal",
        "ManagedIdentity"
      ]
    }
  ],
  "certificationParameterProfile": {
    "immutable": true,
    "pass": {
      "approvedPrincipalTypes": [
        "ServicePrincipal",
        "ManagedIdentity"
      ]
    },
    "fail": {
      "approvedPrincipalTypes": []
    },
    "invalid": {}
  },
  "packageSourceRef": "policy-packages/agcf/AGCF-AZR-031/1.0.0.json"
}
