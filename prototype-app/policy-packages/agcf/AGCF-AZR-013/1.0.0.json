{
  "policyId": "AGCF-AZR-013",
  "version": "1.0.0",
  "name": "RAI mode or base policy is outside the approved baseline",
  "description": "Detects when rAI mode or base policy is outside the approved baseline using only declared evidence.",
  "securityIntent": "Prevent the risk condition described by AGCF-AZR-013.",
  "remediationIntent": "Correct the provider configuration or relationship and reassess with complete, fresh evidence.",
  "owner": "AI Grid Security",
  "lifecycle": "PUBLISHED",
  "releaseStatus": "GENERAL_AVAILABILITY",
  "controlObjectiveId": "AGCF-OBJ-AZR-013",
  "provider": "AZURE",
  "evaluationMode": "ARTIFACT_FACTS",
  "evaluationDefinition": {
    "mode": "ARTIFACT_FACTS",
    "artifactFacts": {
      "predicate": {
        "any": [
          {
            "not": {
              "fact": "guardrail.rai_mode_configured",
              "in": {
                "parameter": "approvedRaiModes"
              }
            }
          },
          {
            "not": {
              "fact": "guardrail.rai_base_policy_configured",
              "in": {
                "parameter": "approvedRaiBasePolicies"
              }
            }
          }
        ]
      }
    }
  },
  "baseEvidenceTiers": [
    "E1"
  ],
  "conditionalCapabilities": [],
  "defaultSelection": "DISABLED",
  "releaseFamily": "AGCF_PHASE_1",
  "wave": "PHASE_1",
  "workflowClass": "POSTURE_FINDING",
  "artifactTypes": [],
  "nativeKinds": [
    "AZURE_RAI_POLICIES"
  ],
  "requiredCapabilities": [
    "FOUNDRY_DEPLOYMENTS_RAI"
  ],
  "requiredRelationships": [],
  "requiredResourceFamilies": [],
  "requiredFacts": [
    {
      "factKey": "guardrail.rai_mode_configured",
      "valueType": "STRING",
      "evidenceClasses": [
        "CONFIGURATION"
      ],
      "maxAgeSeconds": 86400
    },
    {
      "factKey": "guardrail.rai_base_policy_configured",
      "valueType": "STRING",
      "evidenceClasses": [
        "CONFIGURATION"
      ],
      "maxAgeSeconds": 86400
    }
  ],
  "frameworkMappings": [
