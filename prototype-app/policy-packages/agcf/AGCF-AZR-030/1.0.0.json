{
  "policyId": "AGCF-AZR-030",
  "version": "1.0.0",
  "name": "High-privilege Azure role assignment is broader than the approved AI resource scope",
  "description": "Detects when high-privilege Azure role assignment is broader than the approved AI resource scope using only declared evidence.",
  "securityIntent": "Prevent the risk condition described by AGCF-AZR-030.",
  "remediationIntent": "Correct the provider configuration or relationship and reassess with complete, fresh evidence.",
  "owner": "AI Grid Security",
  "lifecycle": "PUBLISHED",
  "releaseStatus": "GENERAL_AVAILABILITY",
  "controlObjectiveId": "AGCF-OBJ-AZR-030",
  "provider": "AZURE",
  "evaluationMode": "ARTIFACT_FACTS",
  "evaluationDefinition": {
    "mode": "ARTIFACT_FACTS",
    "artifactFacts": {
      "predicate": {
        "not": {
          "fact": "identity.assignment_scope_configured",
          "in": {
            "parameter": "approvedAiResourceScopes"
          }
        }
      }
    }
  },
  "baseEvidenceTiers": [
    "E1",
    "E2"
  ],
  "conditionalCapabilities": [],
  "defaultSelection": "REQUIRED",
  "releaseFamily": "AGCF_PHASE_1",
