  "workflowClass": "POSTURE_FINDING",
  "artifactTypes": [],
  "nativeKinds": [
    "AZURE_RBAC_GLOBAL"
  ],
  "requiredCapabilities": [
    "RBAC_ASSIGNMENTS"
  ],
  "requiredRelationships": [],
  "requiredResourceFamilies": [],
  "requiredFacts": [
    {
      "factKey": "identity.assignment_scope_configured",
      "valueType": "STRING",
      "evidenceClasses": [
        "CONFIGURATION"
      ],
      "maxAgeSeconds": 86400
    }
  ],
  "frameworkMappings": [
