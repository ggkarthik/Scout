{
  "policyId": "AGCF-AZR-015",
  "version": "1.0.0",
  "name": "Foundry model name or publisher is outside the approved allowlist",
  "description": "Detects when foundry model name or publisher is outside the approved allowlist using only declared evidence.",
  "securityIntent": "Prevent the risk condition described by AGCF-AZR-015.",
  "remediationIntent": "Correct the provider configuration or relationship and reassess with complete, fresh evidence.",
  "owner": "AI Grid Security",
  "lifecycle": "PUBLISHED",
  "releaseStatus": "GENERAL_AVAILABILITY",
  "controlObjectiveId": "AGCF-OBJ-AZR-015",
  "provider": "AZURE",
  "evaluationMode": "ARTIFACT_FACTS",
  "evaluationDefinition": {
    "mode": "ARTIFACT_FACTS",
    "artifactFacts": {
      "predicate": {
        "any": [
          {
            "not": {
              "fact": "model.name_configured",
              "in": {
                "parameter": "approvedModelNames"
              }
            }
          },
          {
            "not": {
              "fact": "model.publisher_configured",
              "in": {
                "parameter": "approvedModelPublishers"
              }
            }
          }
        ]
      }
    }
  },
  "baseEvidenceTiers": [
    "E1"
  ],
  "conditionalCapabilities": [],
  "defaultSelection": "DISABLED",
  "releaseFamily": "AGCF_PHASE_1",
  "wave": "PHASE_1",
  "workflowClass": "POSTURE_FINDING",
  "artifactTypes": [],
  "nativeKinds": [
    "AZURE_FOUNDRY_DEPLOYMENTS"
  ],
  "requiredCapabilities": [
    "AI_ACCOUNTS"
  ],
  "requiredRelationships": [],
  "requiredResourceFamilies": [],
  "requiredFacts": [
    {
      "factKey": "model.name_configured",
      "valueType": "STRING",
      "evidenceClasses": [
        "CONFIGURATION"
      ],
      "maxAgeSeconds": 86400
    },
    {
      "factKey": "model.publisher_configured",
      "valueType": "STRING",
      "evidenceClasses": [
        "CONFIGURATION"
      ],
      "maxAgeSeconds": 86400
    }
  ],
  "frameworkMappings": [
    {
      "framework": "OWASP_GENAI_LLM_TOP_10",
      "frameworkVersion": "2026",
      "controlId": "LLM04",
      "mappingType": "DIRECT",
      "rationale": "This control is independently mapped to the policy's stated security intent."
    },
    {
      "framework": "CSA_AICM",
      "frameworkVersion": "1.1",
      "controlId": "STA-08",
      "mappingType": "DIRECT",
      "rationale": "This control is independently mapped to the policy's stated security intent."
    },
    {
      "framework": "CSA_AICM",
      "frameworkVersion": "1.1",
      "controlId": "STA-10",
      "mappingType": "DIRECT",
      "rationale": "This control is independently mapped to the policy's stated security intent."
    },
    {
      "framework": "CSA_AICM",
      "frameworkVersion": "1.1",
      "controlId": "MDS-12",
      "mappingType": "PARTIAL",
      "rationale": "This control is independently mapped to the policy's stated security intent."
    }
  ],
  "parameterDefinitions": [
    {
      "key": "approvedModelNames",
      "type": "STRING_LIST",
      "defaultValue": []
    },
    {
      "key": "approvedModelPublishers",
      "type": "STRING_LIST",
      "defaultValue": [
        "Microsoft"
      ]
    }
  ],
  "certificationParameterProfile": {
    "immutable": true,
    "pass": {
      "approvedModelNames": [],
      "approvedModelPublishers": [
        "Microsoft"
      ]
    },
    "fail": {
      "approvedModelNames": [
        "CERTIFICATION_APPROVED_VALUE"
      ],
      "approvedModelPublishers": []
    },
    "invalid": {}
  },
  "packageSourceRef": "policy-packages/agcf/AGCF-AZR-015/1.0.0.json"
}
