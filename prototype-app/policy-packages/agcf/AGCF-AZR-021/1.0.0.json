{
  "policyId": "AGCF-AZR-021",
  "version": "1.0.0",
  "name": "Foundry agent uses a tool type outside the approved tool allowlist",
  "description": "Detects when foundry agent uses a tool type outside the approved tool allowlist using only declared evidence.",
  "securityIntent": "Prevent the risk condition described by AGCF-AZR-021.",
  "remediationIntent": "Correct the provider configuration or relationship and reassess with complete, fresh evidence.",
  "owner": "AI Grid Security",
  "lifecycle": "PUBLISHED",
  "releaseStatus": "GENERAL_AVAILABILITY",
  "controlObjectiveId": "AGCF-OBJ-AZR-021",
  "provider": "AZURE",
  "evaluationMode": "ARTIFACT_FACTS",
  "evaluationDefinition": {
    "mode": "ARTIFACT_FACTS",
    "artifactFacts": {
      "predicate": {
        "not": {
          "fact": "agent.tool_type_configured",
          "in": {
            "parameter": "approvedToolTypes"
          }
        }
      }
    }
  },
  "baseEvidenceTiers": [
    "E1"
  ],
  "conditionalCapabilities": [
    "PURVIEW_CLASSIFICATION",
    "FOUNDRY_AGENTS_OR_SEARCH_DATA_PLANE"
  ],
  "defaultSelection": "DISABLED",
  "releaseFamily": "AGCF_PHASE_1",
  "wave": "PHASE_1",
  "workflowClass": "POSTURE_FINDING",
  "artifactTypes": [],
  "nativeKinds": [
    "AZURE_FOUNDRY_AGENT_TOOLS"
  ],
  "requiredCapabilities": [
    "FOUNDRY_AGENTS_TOOLS"
  ],
  "requiredRelationships": [],
  "requiredResourceFamilies": [],
  "requiredFacts": [
    {
      "factKey": "agent.tool_type_configured",
      "valueType": "STRING",
      "evidenceClasses": [
        "CONFIGURATION"
      ],
      "maxAgeSeconds": 86400
    }
  ],
  "frameworkMappings": [
    {
      "framework": "OWASP_GENAI_LLM_TOP_10",
      "frameworkVersion": "2026",
      "controlId": "LLM03",
      "mappingType": "DIRECT",
      "rationale": "This control is independently mapped to the policy's stated security intent."
    },
    {
      "framework": "CSA_AICM",
      "frameworkVersion": "1.1",
      "controlId": "AIS-11",
      "mappingType": "DIRECT",
      "rationale": "This control is independently mapped to the policy's stated security intent."
    },
    {
      "framework": "CSA_AICM",
      "frameworkVersion": "1.1",
      "controlId": "IAM-18",
      "mappingType": "DIRECT",
      "rationale": "This control is independently mapped to the policy's stated security intent."
    }
  ],
  "parameterDefinitions": [
    {
      "key": "approvedToolTypes",
      "type": "STRING_LIST",
      "defaultValue": [
        "function"
      ]
    }
  ],
  "certificationParameterProfile": {
    "immutable": true,
    "pass": {
      "approvedToolTypes": [
        "function"
      ]
    },
    "fail": {
      "approvedToolTypes": []
    },
    "invalid": {}
  },
  "packageSourceRef": "policy-packages/agcf/AGCF-AZR-021/1.0.0.json"
}
